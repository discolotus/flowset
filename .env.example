# App
APP_ENV=development
APP_ORIGIN=http://localhost:5173

# Spotify OAuth Authorization Code with PKCE (create an app at
# https://developer.spotify.com/dashboard). PKCE uses the public client ID only; do not add a
# Spotify client secret to this desktop/browser configuration.
SPOTIFY_CLIENT_ID=
# Register this exact browser-development callback in the Spotify dashboard. The packaged desktop
# sidecar overrides it with the same path on port 8001.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/v1/spotify/auth/callback

# Audio-feature providers
# ReccoBeats catalog lookups do not require an API key. Coverage varies by playlist.
RECCOBEATS_BASE_URL=https://api.reccobeats.com
RECCOBEATS_TIMEOUT_SECONDS=15
RECCOBEATS_MAX_RATE_LIMIT_RETRIES=1

# Optional local-playlist import and Essentia analysis are limited to user-authorized audio
# beneath this directory. Use the common ancestor of the folders/M3U files to import. Paths
# submitted to the API must be relative to this root. Spotify audio is never downloaded.
ESSENTIA_AUDIO_ROOT=

# Optional for browser development. Run `make setup-essentia-models`, then point this at
# `apps/api/.models/essentia` (or another directory containing the official model bundle).
# The Tauri desktop build bundles and sets this path automatically.
ESSENTIA_MODEL_DIR=

# Maximum wall time for one disposable TensorFlow mood-model worker. A timed-out worker is killed
# without discarding the native BPM, key, danceability, loudness, and spectral measurements.
ESSENTIA_MOOD_WORKER_TIMEOUT_SECONDS=180

# Optional local semantic ranking. Model downloads are always operator-initiated.
# The setup targets install to these defaults; override only when provisioning elsewhere.
# CLAP_CHECKPOINT=./apps/api/.models/semantic/clap/630k-audioset-best.pt
# CLAP_AUDIO_ROOT=/absolute/path/to/authorized/audio
# CLAP_MAX_TRACKS=100
# CLAP_MAX_LABELS=20
# MUQ_MULAN_CHECKPOINT=./apps/api/.models/semantic/muq-mulan
# MERT_CHECKPOINT=./apps/api/.models/semantic/mert/MERT-v1-95M
# SEMANTIC_AUDIO_ROOT=/absolute/path/to/authorized/audio
# SEMANTIC_MAX_EMBEDDINGS=20
# SEMANTIC_MAX_EMBEDDING_DIMENSION=4096

# Optional desktop override for portable MP3 export. The Mac app also checks its Resources
# directory plus /opt/homebrew/bin/ffmpeg, /usr/local/bin/ffmpeg, and PATH.
SEQUENCE_FFMPEG_PATH=

# Persistence (reserved for the first database-backed milestone)
DATABASE_URL=postgresql://playlist_optimizer:playlist_optimizer@localhost:5432/playlist_optimizer
