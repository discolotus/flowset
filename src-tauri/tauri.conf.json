{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Playlist Optimizer",
  "version": "0.1.0",
  "identifier": "com.tanner.playlist-optimizer",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../apps/web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Playlist Optimizer",
        "width": 1440,
        "height": 960,
        "minWidth": 1000,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8001 https://api.reccobeats.com; media-src 'self' http://127.0.0.1:8001; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/playlist-optimizer-api"],
    "resources": {
      "../apps/api/.models/essentia": "models/essentia"
    },
    "macOS": {
      "minimumSystemVersion": "15.2",
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist"
    }
  }
}
